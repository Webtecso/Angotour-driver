import React from 'react';
import { ScrollView, StyleSheet, Text, View } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import ScreenContainer from '../../components/common/ScreenContainer';
import Button from '../../components/common/Button';
import { mockVehicle } from '../../services/mockData';
import { DocumentStatus } from '../../types';
import { colors, radius, spacing, typography } from '../../constants/theme';

const STATUS_COLOR: Record<DocumentStatus, string> = {
  valid: colors.primary,
  expiring_soon: colors.amber,
  expired: colors.danger,
};

const STATUS_LABEL: Record<DocumentStatus, string> = {
  valid: 'Valido',
  expiring_soon: 'Expira em breve',
  expired: 'Expirado',
};

export default function VehicleScreen() {
  const kmToMaintenance = mockVehicle.nextMaintenanceKm - mockVehicle.odometerKm;

  return (
    <ScreenContainer style={styles.container}>
      <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.scroll}>
        <Text style={styles.header}>Meu Veiculo</Text>

        <View style={styles.vehicleCard}>
          <View style={styles.vehicleTop}>
            <View style={styles.vehicleIconBadge}>
              <Ionicons name="car-sport" size={28} color={colors.primary} />
            </View>
            <View style={{ flex: 1 }}>
              <Text style={styles.vehicleModel}>{mockVehicle.model}</Text>
              <Text style={styles.vehiclePlate}>{mockVehicle.plate} - {mockVehicle.year}</Text>
            </View>
            {mockVehicle.isApproved ? (
              <View style={styles.approvedBadge}>
                <Text style={styles.approvedText}>Aprovado</Text>
              </View>
            ) : null}
          </View>
        </View>

        <Text style={styles.sectionTitle}>Documentos</Text>
        <View style={styles.docsCard}>
          {mockVehicle.documents.map((doc) => (
            <View key={doc.id} style={styles.docRow}>
              <Ionicons name="document-text-outline" size={16} color={colors.textSecondary} />
              <Text style={styles.docLabel}>{doc.label}</Text>
              <Text style={[styles.docStatus, { color: STATUS_COLOR[doc.status] }]}>
                {STATUS_LABEL[doc.status]}{doc.expiresInDays ? ` (${doc.expiresInDays}d)` : ''}
              </Text>
            </View>
          ))}
        </View>

        <Text style={styles.sectionTitle}>Manutencao</Text>
        <View style={styles.maintCard}>
          <View style={styles.maintRow}>
            <Text style={styles.maintLabel}>Quilometragem</Text>
            <Text style={styles.maintValue}>{mockVehicle.odometerKm.toLocaleString('pt-AO')} km</Text>
          </View>
          <View style={styles.maintRow}>
            <Text style={styles.maintLabel}>Proxima manutencao</Text>
            <Text style={styles.maintValue}>{mockVehicle.nextMaintenanceKm.toLocaleString('pt-AO')} km</Text>
          </View>
          {kmToMaintenance <= 1000 ? (
            <View style={styles.alertRow}>
              <Ionicons name="warning-outline" size={14} color={colors.amber} />
              <Text style={styles.alertText}>Revisao em {kmToMaintenance} km</Text>
            </View>
          ) : null}
        </View>

        <Button label="Trocar veiculo" variant="outline" onPress={() => {}} style={{ marginTop: spacing.lg }} />
      </ScrollView>
    </ScreenContainer>
  );
}

const styles = StyleSheet.create({
  container: { paddingHorizontal: spacing.lg, paddingTop: spacing.sm },
  scroll: { paddingBottom: spacing.xxl },
  header: { ...typography.h2, color: colors.textPrimary, marginBottom: spacing.md },
  vehicleCard: { backgroundColor: colors.surface, borderRadius: radius.lg, borderWidth: 1, borderColor: colors.border, padding: spacing.md, marginBottom: spacing.lg },
  vehicleTop: { flexDirection: 'row', alignItems: 'center' },
  vehicleIconBadge: { width: 52, height: 52, borderRadius: radius.md, backgroundColor: colors.surfaceRaised, alignItems: 'center', justifyContent: 'center', marginRight: spacing.sm },
  vehicleModel: { ...typography.subtitle, color: colors.textPrimary },
  vehiclePlate: { ...typography.caption, color: colors.textSecondary, marginTop: 2 },
  approvedBadge: { backgroundColor: colors.primaryLight, borderRadius: radius.pill, paddingHorizontal: spacing.sm, paddingVertical: 4 },
  approvedText: { ...typography.tiny, color: colors.primaryDark },
  sectionTitle: { ...typography.subtitle, color: colors.textPrimary, marginBottom: spacing.sm },
  docsCard: { backgroundColor: colors.surface, borderRadius: radius.lg, borderWidth: 1, borderColor: colors.border, marginBottom: spacing.lg, overflow: 'hidden' },
  docRow: { flexDirection: 'row', alignItems: 'center', paddingVertical: spacing.sm, paddingHorizontal: spacing.md, borderBottomWidth: 1, borderBottomColor: colors.border },
  docLabel: { ...typography.body, color: colors.textPrimary, marginLeft: spacing.xs, flex: 1 },
  docStatus: { ...typography.captionMedium },
  maintCard: { backgroundColor: colors.surface, borderRadius: radius.lg, borderWidth: 1, borderColor: colors.border, padding: spacing.md },
  maintRow: { flexDirection: 'row', justifyContent: 'space-between', paddingVertical: 2 },
  maintLabel: { ...typography.body, color: colors.textSecondary },
  maintValue: { ...typography.bodyMedium, color: colors.textPrimary },
  alertRow: { flexDirection: 'row', alignItems: 'center', marginTop: spacing.sm },
  alertText: { ...typography.caption, color: colors.amber, marginLeft: spacing.xxs },
});
